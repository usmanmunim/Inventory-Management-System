{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:/MinGW/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\main.c",
                "${fileDirname}\\Common.c",
                "${fileDirname}\\Product.c",
                "${fileDirname}\\Inventory.c",
                "${fileDirname}\\Category_Supplier.c",
                "${fileDirname}\\User_Transaction.c",
                "${fileDirname}\\FileOperations.c",
                "-o",
                "${fileDirname}\\main.exe"
            ],
            "options": {
                "cwd": "C:/MinGW/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\main.exe",
                "${fileDirname}\\main.c",
                "${fileDirname}\\Common.c",
                "${fileDirname}\\Product.c",
                "${fileDirname}\\Inventory.c",
                "${fileDirname}\\Category_Supplier.c",
                "${fileDirname}\\User_Transaction.c",
                "${fileDirname}\\FileOperations.c"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
